# Copy to .env for local development (Development environment only; .env is gitignored).
# In Azure, set these as App Service settings, with secrets as Key Vault references (NF-05).

# SQL Server. Local: LocalDB. Azure: Azure SQL in South Africa North (NF-04).
ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=EngineeredTutors;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=60

# Two DIFFERENT random 32-byte keys, base64. Generate each with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Changing EncryptionKey makes stored ID numbers unreadable; changing IdHashKey breaks duplicate checks.
Security__EncryptionKey=
Security__IdHashKey=

# Where completion alerts go (NT-02).
Site__AdminAlertEmail=

# Email. Mode=Pickup writes emails to api/src/EngineeredTutors.Api/mail-pickup/ instead of sending.
Email__Mode=Pickup
Email__From=
Email__SmtpHost=
Email__SmtpUser=
Email__SmtpPassword=

# Cloudflare Turnstile secret (REG-06). Blank is allowed in Development only.
Turnstile__SecretKey=

# Entra ID admin sign-in (AD-01).
AdminAuth__TenantId=
AdminAuth__ApiClientId=
AdminAuth__AllowedObjectIds__0=
# Development only: lets the local admin page sign in with this key instead of Entra ID.
AdminAuth__DevKey=

# Development only: question CSVs to import and publish on first run. They contain the answers; keep them out of git.
Seed__MathsCsv=
Seed__PhysicalSciencesCsv=
